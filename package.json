{

  "name"        : "fuzzysort",
  "version"     : "4.0.0",
  "author"      : "farzher",
  "license"     : "MIT",
  "description" : "Fast SublimeText-like fuzzy search for JavaScript",

  "keywords": ["fuzzy search", "fuzzy", "search", "filter", "javascript", "node", "fast", "sublime"],

  "repository": {
    "type" : "git",
    "url"  : "https://github.com/farzher/fuzzysort.git"
  },

  "type": "module",
  "main": "fuzzysort.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./fuzzysort.js"
    }
  },

  "scripts": {
    "test"     : "node test/test.js",
    "test-min" : "node test/test.js min",

    "minify"   : "terser fuzzysort.js -o fuzzysort.min.js --config-file terser.config.json",
    "check"    : "npm test && npm run test-min",
    "build"    : "npm run minify && npm run check",
    "release"  : "npm run build && node test/build.js"
  },

  "files": [
    "fuzzysort.js",
    "fuzzysort.min.js",
    "index.d.ts"
  ],

  "types": "index.d.ts",

  "devDependencies": {
    "terser": "^5.49.2"
  }

}
